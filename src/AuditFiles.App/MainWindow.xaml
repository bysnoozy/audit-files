<Window x:Class="AuditFiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AuditFiles.App.ViewModels"
        Title="Audit de migration SharePoint" Height="700" Width="1100" MinWidth="800" MinHeight="500">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Parcourir..." Width="100" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="Dossier :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Lancer l'audit" Width="120" Margin="0,0,8,0" Command="{Binding StartScanCommand}" />
            <Button Content="Annuler" Width="100" Margin="0,0,8,0" Command="{Binding CancelScanCommand}" />
            <Button Content="Exporter CSV" Width="120" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" />
            <Button Content="Exporter HTML" Width="120" Margin="0,0,8,0" Command="{Binding ExportHtmlCommand}" />
            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555555" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
            <Border Background="#F3F2F1" CornerRadius="6" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding TotalFiles}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Fichiers" Foreground="#555555" />
                </StackPanel>
            </Border>
            <Border Background="#F3F2F1" CornerRadius="6" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding TotalFolders}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Dossiers" Foreground="#555555" />
                </StackPanel>
            </Border>
            <Border Background="#F3F2F1" CornerRadius="6" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding TotalSize}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Taille totale" Foreground="#555555" />
                </StackPanel>
            </Border>
            <Border Background="#F3F2F1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding IssueCount}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Anomalies" Foreground="#555555" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="90" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="200" />
                <DataGridTextColumn Header="Chemin" Binding="{Binding RelativePath}" Width="3*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="4*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="#333333" />
    </Grid>
</Window>
